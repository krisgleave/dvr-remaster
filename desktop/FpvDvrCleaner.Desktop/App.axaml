<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FpvDvrCleaner.Desktop.App"
             RequestedThemeVariant="Dark">


    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Sliders, check boxes, progress bars and focus use the studio orange. -->
                <ColorPaletteResources x:Key="Dark" Accent="#FFD78C52" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
