<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FpvDvrCleaner.Desktop.App"
             RequestedThemeVariant="Dark">


    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Sliders, check boxes, progress bars and focus use the blue. -->
                <ColorPaletteResources x:Key="Dark" Accent="#FF0A84FF" />
            </FluentTheme.Palettes>
        </FluentTheme>

    <Style Selector="ComboBox"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="7,3"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button.compact"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="7,3"/></Style>
    <Style Selector="Button.playing /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#16864C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#0A84FF"/><Setter Property="LetterSpacing" Value="0.6"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F2F2F7"/></Style>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="#B4B0AA"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#C7C2BB"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#28282A"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="22"/><Setter Property="BorderBrush" Value="#38383B"/><Setter Property="BorderThickness" Value="1"/></Style>

    <Style Selector="Button"><Setter Property="Background" Value="#343436"/><Setter Property="Foreground" Value="#F2F2F7"/><Setter Property="Padding" Value="10,4"/><Setter Property="CornerRadius" Value="8"/><Setter Property="FontSize" Value="13"/></Style>
    <!-- Fluent paints hover and pressed states on the template part, so every
         state is set there too; otherwise it would fall back to grey on white. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#454447"/><Setter Property="Foreground" Value="#F2F2F7"/></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#535154"/><Setter Property="Foreground" Value="#F2F2F7"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#27272A"/><Setter Property="Foreground" Value="#7D858A"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#409CFF"/><Setter Property="Foreground" Value="#1C1C1E"/></Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#0066CC"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#343436"/><Setter Property="Foreground" Value="#777A80"/></Style>
    <Style Selector="Button.dark"><Setter Property="Background" Value="#3A424A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4B545D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.dark:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#5A646E"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.dark:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#30373E"/><Setter Property="Foreground" Value="#7E878F"/></Style>
    <Style Selector="Button.step"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D3D8DC"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,3"/></Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#353C43"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.step:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4A535C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.step.current /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#254B70"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.step.current:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#305F8A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.row"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <!-- Square icon buttons of the queue rows: as tall as Copy and Trim, the vector icon centred exactly.
         Disabled keeps the same background; only the icon fades (see MainWindow.VectorIcon). -->
    <Style Selector="Button.square"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.square:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#343436"/></Style>
    <Style Selector="Button.square:disabled Path"><Setter Property="Opacity" Value="0.35"/></Style>
    <Style Selector="Button.remove"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9C3F1F"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F6DED4"/><Setter Property="Foreground" Value="#7A2E14"/></Style>

    <Style Selector="RadioButton.segment">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Background" Value="#2C2C2F"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6" Margin="0,0,6,0">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover"><Setter Property="Background" Value="#414044"/></Style>
    <Style Selector="RadioButton.segment:checked"><Setter Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#1C1C1E"/></Style>
    <Style Selector="RadioButton.segment:checked:pointerover"><Setter Property="Background" Value="#409CFF"/></Style>
    <!-- Small rounded chips, e.g. the look presets; none is checked for custom values. -->
    <Style Selector="RadioButton.chip">
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="Background" Value="#2C2C2F"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="11,4" Margin="0,0,6,0">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.chip:pointerover"><Setter Property="Background" Value="#414044"/></Style>
    <Style Selector="RadioButton.chip:checked"><Setter Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#1C1C1E"/></Style>
    <Style Selector="RadioButton.chip:checked:pointerover"><Setter Property="Background" Value="#409CFF"/></Style>
    <Style Selector="RadioButton.chip:disabled"><Setter Property="Opacity" Value="0.55"/></Style>

    <Style Selector="TextBox"><Setter Property="Background" Value="#28282A"/><Setter Property="Foreground" Value="#F2F2F7"/><Setter Property="BorderBrush" Value="#515054"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="RadioButton.segment"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBox.dark"><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Consolas, Menlo, monospace"/><Setter Property="MinHeight" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Border.card.tight"><Setter Property="Padding" Value="14,10"/></Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#28282A"/><Setter Property="BorderBrush" Value="#0A84FF"/></Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#28282A"/><Setter Property="BorderBrush" Value="#0A84FF"/></Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark"><Setter Property="Foreground" Value="#6E767B"/></Style>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="#F2F2F7"/></Style>
    <Style Selector="CheckBox.light"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.tool"><Setter Property="Background" Value="#2A3138"/><Setter Property="Foreground" Value="#E6EAED"/><Setter Property="Padding" Value="9,4"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#3A424A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4B545D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#23292F"/><Setter Property="Foreground" Value="#6E777F"/></Style>
    <Style Selector="ToggleButton.tool"><Setter Property="Background" Value="#2A3138"/><Setter Property="Foreground" Value="#E6EAED"/><Setter Property="Padding" Value="9,4"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#3A424A"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2D9CDB"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2487BF"/><Setter Property="Foreground" Value="White"/></Style>

    <!-- Segmented choice: a grey bar, the chosen segment a white pill with orange text.
         A third segment can be added to any bar without changing its look. -->
    <Style Selector="Border.segbar"><Setter Property="Background" Value="#2C2C2F"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="2"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style Selector="RadioButton.seg">
      <Setter Property="Foreground" Value="#C7C2BB"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="SegPill" Background="{TemplateBinding Background}" CornerRadius="7" Padding="11,4">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.seg:pointerover"><Setter Property="Foreground" Value="#F2F2F7"/></Style>
    <Style Selector="RadioButton.seg:checked"><Setter Property="Background" Value="#28282A"/><Setter Property="Foreground" Value="#0A84FF"/></Style>
    <Style Selector="RadioButton.seg:checked /template/ Border#SegPill"><Setter Property="BoxShadow" Value="0 1 2 0 #26000000"/></Style>
    <Style Selector="RadioButton.seg:disabled"><Setter Property="Opacity" Value="0.5"/></Style>

    <!-- The user's own presets: rows like radio buttons, with a menu button. -->
    <Style Selector="Button.presetrow"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="8,5"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Button.presetrow:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1E1E1E"/></Style>
    <Style Selector="Button.presetrow.active /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#253B50"/></Style>
    <Style Selector="Button.cardmenu"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.cardmenu:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2C2C2F"/></Style>
    <Style Selector="TextBlock.cardname"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F2F2F7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.cardline"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#B4B0AA"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="14"/></Style>

    <!-- Small "Show" buttons with an eye, next to each control under Advanced. -->
    <Style Selector="Button.eye"><Setter Property="Padding" Value="7,2"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="#303033"/><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="20"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#0A84FF"/><Setter Property="Padding" Value="4,2"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#253B50"/><Setter Property="Foreground" Value="#7A3400"/></Style>
    <Style Selector="TextBlock.rowlabel"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F2F2F7"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.tech"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#7D858A"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.value"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#C7C2BB"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinWidth" Value="24"/><Setter Property="TextAlignment" Value="Right"/></Style>

    <!-- Export purposes: four cards instead of codec names. -->
    <Style Selector="RadioButton.purpose">
      <Setter Property="Background" Value="#28282A"/><Setter Property="BorderBrush" Value="#38383B"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="4" Padding="14,10">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.purpose:pointerover"><Setter Property="Background" Value="#303033"/><Setter Property="BorderBrush" Value="#555156"/></Style>
    <Style Selector="RadioButton.purpose:checked"><Setter Property="Background" Value="#253B50"/><Setter Property="BorderBrush" Value="#0A84FF"/></Style>
    <Style Selector="RadioButton.purpose:disabled"><Setter Property="Opacity" Value="0.55"/></Style>
    <Style Selector="Border.chip"><Setter Property="Background" Value="#1E1E1E"/><Setter Property="BorderBrush" Value="#38383B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/></Style>
    <Style Selector="Expander.plain"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,8,0,0"/><Setter Property="Margin" Value="-10,0"/></Style>
    <Style Selector="Expander.plain /template/ ToggleButton#ExpanderHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Expander.plain /template/ ToggleButton#ExpanderHeader /template/ Border#ExpanderHeaderBorder"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Expander.plain /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpanderHeaderBorder"><Setter Property="Background" Value="#1E1E1E"/></Style>
    <Style Selector="Expander.plain /template/ Border#ExpanderContent"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4,10,0"/></Style>

        <Style Selector="Window"><Setter Property="Background" Value="#242426"/><Setter Property="Foreground" Value="#F2F2F7"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="ComboBoxItem"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="Normal"/></Style>
    </Application.Styles>
</Application>
